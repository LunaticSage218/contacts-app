@startuml
left to right direction
skinparam packageStyle rectangle

actor User

rectangle "Contact Manager System" {

    usecase "View Contacts" as UC1
    usecase "Add Contact" as UC2
    usecase "Add Multiple Contacts" as UC3
    usecase "Delete Contact" as UC4

    usecase "Modify Contact" as UC5
    usecase "Modify Name" as UC6
    usecase "Modify Address" as UC7
    usecase "Modify Phone Number" as UC8

    usecase "Remove Name\n(Without Invalidating Contact)" as UC9
    usecase "Remove Address\n(Without Invalidating Contact)" as UC10
    usecase "Remove Phone Number\n(Without Invalidating Contact)" as UC11
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5

UC3 ..> UC2 : <<include>>

UC6 ..> UC5 : <<extend>>
UC7 ..> UC5 : <<extend>>
UC8 ..> UC5 : <<extend>>

UC9 ..> UC6 : <<extend>>
UC10 ..> UC7 : <<extend>>
UC11 ..> UC8 : <<extend>>

@enduml
